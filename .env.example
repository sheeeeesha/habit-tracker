# Cross-device sync is optional. Leave these unset and the app runs local-only.
#
# Both values come from your Supabase project:
#   Project Settings -> Data API -> Project URL / anon public key
#
# The anon key is safe to expose: every table is protected by row-level
# security, so it can only ever read and write the signed-in user's own rows.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Written insights (optional). Without this, Insights still works in full —
# only the "read my numbers" panel reports that it is not configured.
#
# NO NEXT_PUBLIC_ PREFIX, deliberately. That prefix inlines a value into the
# browser bundle; this key is read server-side in app/api/insight/route.ts and
# must never reach a client.
ANTHROPIC_API_KEY=
